-- HIGHLIGHT SYSTEM
local HighlightSystem = {Enabled = false, Highlights = {}, BillboardGuis = {}}

local function CreateHighlight(targetPlayer)
	if not targetPlayer or targetPlayer == Player then return end
	local character = targetPlayer.Character
	if not character then return end
	if HighlightSystem.Highlights[targetPlayer] then HighlightSystem.Highlights[targetPlayer]:Destroy() HighlightSystem.Highlights[targetPlayer] = nil end
	if HighlightSystem.BillboardGuis[targetPlayer] then HighlightSystem.BillboardGuis[targetPlayer]:Destroy() HighlightSystem.BillboardGuis[targetPlayer] = nil end
	local highlight = Instance.new("Highlight")
	highlight.FillColor = Color3.fromRGB(255, 182, 193)
	highlight.FillTransparency = 0.5
	highlight.OutlineColor = Color3.fromRGB(255, 105, 180)
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = character
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 200, 0, 30)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = character:WaitForChild("Head")
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 0, 1, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = targetPlayer.Name
	nameLabel.TextColor3 = Color3.fromRGB(255, 105, 180)
	nameLabel.TextSize = 14
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextStrokeTransparency = 0.5
	nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
	nameLabel.Parent = billboard
	HighlightSystem.Highlights[targetPlayer] = highlight
	HighlightSystem.BillboardGuis[targetPlayer] = billboard
end

local function RemoveHighlight(targetPlayer)
	if not targetPlayer then return end
	if HighlightSystem.Highlights[targetPlayer] then HighlightSystem.Highlights[targetPlayer]:Destroy() HighlightSystem.Highlights[targetPlayer] = nil end
	if HighlightSystem.BillboardGuis[targetPlayer] then HighlightSystem.BillboardGuis[targetPlayer]:Destroy() HighlightSystem.BillboardGuis[targetPlayer] = nil end
end

local function UpdateHighlights()
	for _, targetPlayer in pairs(Players:GetPlayers()) do
		if targetPlayer ~= Player then
			if HighlightSystem.Enabled then CreateHighlight(targetPlayer) else RemoveHighlight(targetPlayer) end
		end
	end
end

Players.PlayerAdded:Connect(function(targetPlayer)
	if HighlightSystem.Enabled then targetPlayer.CharacterAdded:Connect(function() CreateHighlight(targetPlayer) end) end
end)
Players.PlayerRemoving:Connect(function(targetPlayer) RemoveHighlight(targetPlayer) end)

